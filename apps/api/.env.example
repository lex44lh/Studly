# Только локальная разработка. Backend автоматически читает apps/api/.env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-studly-local-development-only-not-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

POSTGRES_DB=studly
POSTGRES_USER=studly
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Получить для собственного бота. Не коммитить значения и не отправлять в чат.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Должен точно совпадать с адресом, зарегистрированным в BotFather.
TELEGRAM_OIDC_REDIRECT_URI=

# Срок доказательства входа и допустимая погрешность часов, в секундах.
TELEGRAM_AUTH_MAX_AGE=300
TELEGRAM_AUTH_CLOCK_SKEW=30
TELEGRAM_OIDC_STATE_MAX_AGE=300
