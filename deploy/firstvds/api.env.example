# Образец. Настоящий файл: /etc/studly/api.env, root:root, права 0600.
# Не копировать локальный apps/api/.env и не использовать эти значения как секреты.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=GENERATE_A_NEW_RANDOM_SECRET_ON_THE_SERVER
DJANGO_ALLOWED_HOSTS=studly-help.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://studly-help.ru
DJANGO_STATIC_ROOT=/srv/studly/static
DJANGO_MEDIA_ROOT=/var/lib/studly-api/avatars
POSTGRES_DB=studly
POSTGRES_USER=studly_api
POSTGRES_PASSWORD=GENERATE_A_SEPARATE_RANDOM_DATABASE_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
TELEGRAM_BOT_TOKEN=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://studly-help.ru/api/v1/auth/telegram/callback/
YOOKASSA_TEST_SHOP_ID=
YOOKASSA_TEST_SECRET_KEY=
