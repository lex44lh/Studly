# Copy outside Git to a NEW private file. Use its absolute path as STUDLY_ENV_FILE.
DJANGO_SETTINGS_MODULE=config.live_test
STUDLY_LIVE_TEST_CONFIRM=isolated-synthetic-only
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-studly-local-development-only-not-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,live-test.studly-help.ru
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
DJANGO_MEDIA_ROOT=/private/tmp/studly-live-test/live-test-media
POSTGRES_DB=studly_live_test
POSTGRES_USER=studly_live_test
POSTGRES_PASSWORD=replace-with-a-new-private-test-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
TELEGRAM_BOT_TOKEN=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=
YOOKASSA_TEST_SHOP_ID=
YOOKASSA_TEST_SECRET_KEY=
STUDLY_V2_BUYER_TARIFF=buyer-5-v1
