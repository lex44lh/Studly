{
  "name": "studly",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "apps/api/.venv/bin/python apps/api/manage.py runserver 127.0.0.1:8000",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  }
}
